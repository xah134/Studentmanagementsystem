generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model users {
  id               String        @id @default(uuid())
  email            String        @unique
  auth_id          String?       @unique
  first_name       String?
  last_name        String?
  phone            String?
  is_deleted       Boolean       @default(false)
  role             Role
  institution_id   String?
  site_id          String?
  created_at       DateTime      @default(now())
  updated_at       DateTime      @default(now()) @updatedAt
  institution      institutions? @relation(fields: [institution_id], references: [id])
  site             sites?        @relation(fields: [site_id], references: [id])
  student_profile  students?
  lecturer_profile lecturers?

  @@map("users")
}

model institutions {
  id               String          @id @default(uuid())
  name             String
  logo             String?
  email            String          @unique
  website          String?
  phone            String?
  address          String?
  city             String?
  state            String?
  country          String?
  zip              String?
  latitude         Float?
  longitude        Float?
  institution_type InstitutionType
  description      String?
  is_deleted       Boolean         @default(false)
  created_at       DateTime        @default(now())
  updated_at       DateTime        @default(now()) @updatedAt

  sites     sites[]
  users     users[]
  lecturers lecturers[]
  faculties faculties[]
  courses   courses[]

  @@map("institutions")
}

model sites {
  id             String   @id @default(uuid())
  name           String
  address        String?
  city           String?
  state          String?
  zip            String?
  latitude       Float?
  longitude      Float?
  description    String?
  is_deleted     Boolean  @default(false)
  created_at     DateTime @default(now())
  updated_at     DateTime @default(now()) @updatedAt
  institution_id String

  institution     institutions      @relation(fields: [institution_id], references: [id])
  users           users[]
  students        students[]
  lecturers       lecturers[]
  faculties       faculties[]
  courses         courses[]
  site_whatsapp   site_whatsapp?
  support_tickets support_tickets[]

  @@unique([institution_id, name])
  @@map("sites")
}

model faculties {
  id             String   @id @default(uuid())
  name           String
  code           String?
  description    String?
  is_deleted     Boolean  @default(false)
  created_at     DateTime @default(now())
  updated_at     DateTime @default(now()) @updatedAt
  institution_id String
  site_id        String?

  institution institutions @relation(fields: [institution_id], references: [id])
  site        sites?       @relation(fields: [site_id], references: [id])
  lecturers   lecturers[]
  courses     courses[]

  @@unique([institution_id, name])
  @@map("faculties")
}

model courses {
  id             String   @id @default(uuid())
  name           String
  code           String?
  description    String?
  is_deleted     Boolean  @default(false)
  created_at     DateTime @default(now())
  updated_at     DateTime @default(now()) @updatedAt
  institution_id String
  faculty_id     String
  site_id        String?

  institution institutions @relation(fields: [institution_id], references: [id])
  faculty     faculties    @relation(fields: [faculty_id], references: [id])
  site        sites?       @relation(fields: [site_id], references: [id])

  @@unique([institution_id, name])
  @@map("courses")
}

model students {
  id                  String             @id @default(uuid())
  phone               String?
  address             String?
  city                String?
  state               String?
  zip                 String?
  country             String?
  foreign_national    Boolean            @default(false)
  passport_number     String?
  id_number           String?
  date_of_birth       DateTime?          @db.Date
  gender              Gender?
  nationality         String?
  site_id             String
  verification_status VerificationStatus @default(PENDING)
  is_deleted          Boolean            @default(false)
  created_at          DateTime           @default(now())
  updated_at          DateTime           @default(now()) @updatedAt
  user_id             String?             @unique

  site              sites               @relation(fields: [site_id], references: [id])
  user              users?               @relation(fields: [user_id], references: [id])
  student_documents student_documents[]
  guardians         guardians[]

  @@map("students")
}

model lecturers {
  id                  String             @id @default(uuid())
  phone               String?
  foreign_national    Boolean            @default(false)
  passport_number     String?
  id_number           String?
  date_of_birth       DateTime?          @db.Date
  gender              Gender?
  nationality         String?
  address             String?
  city                String?
  state               String?
  zip                 String?
  country             String?
  site_id             String?
  institution_id      String
  department_id       String?
  verification_status VerificationStatus @default(PENDING)
  is_deleted          Boolean            @default(false)
  created_at          DateTime           @default(now())
  updated_at          DateTime           @default(now()) @updatedAt
  user_id             String?            @unique

  site               sites?               @relation(fields: [site_id], references: [id])
  institution        institutions         @relation(fields: [institution_id], references: [id])
  department         faculties?           @relation(fields: [department_id], references: [id])
  user               users?               @relation(fields: [user_id], references: [id])
  lecturer_documents lecturer_documents[]

  @@map("lecturers")
}

model guardians {
  id           String   @id @default(uuid())
  student_id   String
  name         String
  relationship String
  phone        String?
  email        String?
  created_at   DateTime @default(now())
  updated_at   DateTime @default(now()) @updatedAt

  student students @relation(fields: [student_id], references: [id])

  @@map("guardians")
}

model student_documents {
  id                  String             @id @default(uuid())
  student_id          String
  document_type_id    String
  document_url        String
  verification_status VerificationStatus @default(PENDING)
  created_at          DateTime           @default(now())
  updated_at          DateTime           @default(now()) @updatedAt

  student       students               @relation(fields: [student_id], references: [id])
  document_type student_document_types @relation(fields: [document_type_id], references: [id])

  @@map("student_documents")
}

model lecturer_documents {
  id                  String             @id @default(uuid())
  lecturer_id         String
  document_type_id    String
  document_url        String
  verification_status VerificationStatus @default(PENDING)
  created_at          DateTime           @default(now())
  updated_at          DateTime           @default(now()) @updatedAt

  lecturer      lecturers               @relation(fields: [lecturer_id], references: [id])
  document_type lecturer_document_types @relation(fields: [document_type_id], references: [id])

  @@map("lecturer_documents")
}

model lecturer_document_types {
  id         String   @id @default(uuid())
  name       String   @unique
  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  lecturer_documents lecturer_documents[]

  @@map("lecturer_document_types")
}

model student_document_types {
  id         String   @id @default(uuid())
  name       String   @unique
  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  student_documents student_documents[]

  @@map("student_document_types")
}

enum Role {
  SYSTEM_ADMIN
  INSTITUTION_ADMIN
  SITE_ADMIN
  LECTURER
  STUDENT
}

enum InstitutionType {
  UNIVERSITY
  COLLEGE
  HIGH_SCHOOL
  PRIMARY_SCHOOL
  KINDERGARTEN
  OTHER
}

enum Gender {
  MALE
  FEMALE
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  WAITING
  DONE
}

enum SupportMessageDirection {
  INBOUND
  OUTBOUND
}

model site_whatsapp {
  id           String   @id @default(uuid())
  site_id      String   @unique
  session_name String   @unique
  is_deleted   Boolean  @default(false)
  created_at   DateTime @default(now())
  updated_at   DateTime @default(now()) @updatedAt

  site sites @relation(fields: [site_id], references: [id])

  @@map("site_whatsapp")
}

model support_tickets {
  id         String              @id @default(uuid())
  site_id    String
  chat_id    String
  status     SupportTicketStatus @default(OPEN)
  preview    String?
  opened_at  DateTime?
  created_at DateTime            @default(now())
  updated_at DateTime            @default(now()) @updatedAt

  site     sites              @relation(fields: [site_id], references: [id])
  messages support_messages[]

  @@index([site_id, chat_id])
  @@map("support_tickets")
}

model support_messages {
  id              String                  @id @default(uuid())
  ticket_id       String
  direction       SupportMessageDirection
  body            String
  waha_message_id String?
  created_at      DateTime                @default(now())

  ticket support_tickets @relation(fields: [ticket_id], references: [id])

  @@index([ticket_id])
  @@map("support_messages")
}
