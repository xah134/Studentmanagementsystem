generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model users {
  id               String        @id @default(uuid())
  email            String        @unique
  auth_id          String?       @unique
  first_name       String?
  last_name        String?
  phone            String?
  is_deleted       Boolean       @default(false)
  role             Role
  institution_id   String?
  site_id          String?
  created_at       DateTime      @default(now())
  updated_at       DateTime      @default(now()) @updatedAt
  institution      institutions? @relation(fields: [institution_id], references: [id])
  site             sites?        @relation(fields: [site_id], references: [id])
  student_profile  students?
  lecturer_profile lecturers?

  @@map("users")
}

model institutions {
  id               String          @id @default(uuid())
  name             String
  logo             String?
  email            String          @unique
  website          String?
  phone            String?
  address          String?
  city             String?
  state            String?
  country          String?
  zip              String?
  latitude         Float?
  longitude        Float?
  institution_type InstitutionType
  description      String?
  is_deleted       Boolean         @default(false)
  created_at       DateTime        @default(now())
  updated_at       DateTime        @default(now()) @updatedAt

  sites           sites[]
  users           users[]
  lecturers       lecturers[]
  faculties       faculties[]
  courses         courses[]
  modules         modules[]
  academic_years       academic_years[]
  calendar_events      calendar_events[]
  timetable_slots      timetable_slots[]
  student_enrollments  student_enrollments[]

  @@map("institutions")
}

model sites {
  id             String   @id @default(uuid())
  name           String
  address        String?
  city           String?
  state          String?
  zip            String?
  latitude       Float?
  longitude      Float?
  description    String?
  is_deleted     Boolean  @default(false)
  created_at     DateTime @default(now())
  updated_at     DateTime @default(now()) @updatedAt
  institution_id String

  institution     institutions      @relation(fields: [institution_id], references: [id])
  users           users[]
  students        students[]
  lecturers       lecturers[]
  faculties       faculties[]
  courses         courses[]
  site_whatsapp   site_whatsapp?
  support_tickets support_tickets[]
  calendar_events calendar_events[]
  timetable_slots timetable_slots[]

  @@unique([institution_id, name])
  @@map("sites")
}

model faculties {
  id             String   @id @default(uuid())
  name           String
  code           String?
  description    String?
  is_deleted     Boolean  @default(false)
  created_at     DateTime @default(now())
  updated_at     DateTime @default(now()) @updatedAt
  institution_id String
  site_id        String?

  institution institutions @relation(fields: [institution_id], references: [id])
  site        sites?       @relation(fields: [site_id], references: [id])
  lecturers   lecturers[]
  courses     courses[]

  @@unique([institution_id, name])
  @@map("faculties")
}

model courses {
  id             String   @id @default(uuid())
  name           String
  code           String?
  description    String?
  is_deleted     Boolean  @default(false)
  created_at     DateTime @default(now())
  updated_at     DateTime @default(now()) @updatedAt
  institution_id String
  faculty_id     String
  site_id        String?

  institution     institutions      @relation(fields: [institution_id], references: [id])
  faculty         faculties         @relation(fields: [faculty_id], references: [id])
  site            sites?            @relation(fields: [site_id], references: [id])
  modules             modules[]
  timetable_slots     timetable_slots[]
  student_enrollments student_enrollments[]

  @@unique([institution_id, name])
  @@map("courses")
}

model modules {
  id             String   @id @default(uuid())
  name           String
  code           String?
  description    String?
  credits        Int?
  is_deleted     Boolean  @default(false)
  created_at     DateTime @default(now())
  updated_at     DateTime @default(now()) @updatedAt
  institution_id String
  course_id      String

  institution     institutions      @relation(fields: [institution_id], references: [id])
  course          courses           @relation(fields: [course_id], references: [id])
  timetable_slots timetable_slots[]

  @@unique([course_id, name])
  @@map("modules")
}

model students {
  id                  String             @id @default(uuid())
  first_name          String?
  last_name           String?
  phone               String?
  address             String?
  city                String?
  state               String?
  zip                 String?
  country             String?
  foreign_national    Boolean            @default(false)
  passport_number     String?
  id_number           String?
  date_of_birth       DateTime?          @db.Date
  gender              Gender?
  nationality         String?
  site_id             String
  verification_status VerificationStatus @default(PENDING)
  is_deleted          Boolean            @default(false)
  created_at          DateTime           @default(now())
  updated_at          DateTime           @default(now()) @updatedAt
  user_id             String?             @unique

  site                sites                 @relation(fields: [site_id], references: [id])
  user                users?                @relation(fields: [user_id], references: [id])
  student_documents   student_documents[]
  guardians           guardians[]
  student_enrollments student_enrollments[]
  attendance_records  attendance_records[]

  @@map("students")
}

model lecturers {
  id                  String             @id @default(uuid())
  first_name          String?
  last_name           String?
  phone               String?
  foreign_national    Boolean            @default(false)
  passport_number     String?
  id_number           String?
  date_of_birth       DateTime?          @db.Date
  gender              Gender?
  nationality         String?
  address             String?
  city                String?
  state               String?
  zip                 String?
  country             String?
  site_id             String?
  institution_id      String
  department_id       String?
  verification_status VerificationStatus @default(PENDING)
  is_deleted          Boolean            @default(false)
  created_at          DateTime           @default(now())
  updated_at          DateTime           @default(now()) @updatedAt
  user_id             String?            @unique

  site               sites?               @relation(fields: [site_id], references: [id])
  institution        institutions         @relation(fields: [institution_id], references: [id])
  department         faculties?           @relation(fields: [department_id], references: [id])
  user               users?               @relation(fields: [user_id], references: [id])
  lecturer_documents lecturer_documents[]

  @@map("lecturers")
}

model guardians {
  id           String   @id @default(uuid())
  student_id   String
  name         String
  relationship String
  phone        String?
  email        String?
  created_at   DateTime @default(now())
  updated_at   DateTime @default(now()) @updatedAt

  student students @relation(fields: [student_id], references: [id])

  @@map("guardians")
}

model student_documents {
  id                  String             @id @default(uuid())
  student_id          String
  document_type_id    String
  document_url        String
  verification_status VerificationStatus @default(PENDING)
  created_at          DateTime           @default(now())
  updated_at          DateTime           @default(now()) @updatedAt

  student       students               @relation(fields: [student_id], references: [id])
  document_type student_document_types @relation(fields: [document_type_id], references: [id])

  @@map("student_documents")
}

model lecturer_documents {
  id                  String             @id @default(uuid())
  lecturer_id         String
  document_type_id    String
  document_url        String
  verification_status VerificationStatus @default(PENDING)
  created_at          DateTime           @default(now())
  updated_at          DateTime           @default(now()) @updatedAt

  lecturer      lecturers               @relation(fields: [lecturer_id], references: [id])
  document_type lecturer_document_types @relation(fields: [document_type_id], references: [id])

  @@map("lecturer_documents")
}

model lecturer_document_types {
  id         String   @id @default(uuid())
  name       String   @unique
  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  lecturer_documents lecturer_documents[]

  @@map("lecturer_document_types")
}

model student_document_types {
  id         String   @id @default(uuid())
  name       String   @unique
  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  student_documents student_documents[]

  @@map("student_document_types")
}

enum Role {
  SYSTEM_ADMIN
  INSTITUTION_ADMIN
  SITE_ADMIN
  LECTURER
  STUDENT
}

enum InstitutionType {
  UNIVERSITY
  COLLEGE
  HIGH_SCHOOL
  PRIMARY_SCHOOL
  KINDERGARTEN
  OTHER
}

enum Gender {
  MALE
  FEMALE
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  WAITING
  DONE
}

enum SupportMessageDirection {
  INBOUND
  OUTBOUND
}

enum CalendarEventType {
  EXAM
  BREAK
  HOLIDAY
  SPECIAL
  OTHER
}

model academic_years {
  id             String   @id @default(uuid())
  institution_id String
  name           String
  starts_on      DateTime @db.Date
  ends_on        DateTime @db.Date
  is_deleted     Boolean  @default(false)
  created_at     DateTime @default(now())
  updated_at     DateTime @default(now()) @updatedAt

  institution         institutions          @relation(fields: [institution_id], references: [id])
  calendar_events     calendar_events[]
  student_enrollments student_enrollments[]

  @@unique([institution_id, name])
  @@map("academic_years")
}

model calendar_events {
  id               String            @id @default(uuid())
  institution_id   String
  academic_year_id String
  site_id          String?
  title            String
  description      String?
  event_type       CalendarEventType @default(OTHER)
  starts_at        DateTime
  ends_at          DateTime
  all_day          Boolean           @default(true)
  color            String?
  emoji            String?
  image_url        String?
  is_deleted       Boolean           @default(false)
  created_at       DateTime          @default(now())
  updated_at       DateTime          @default(now()) @updatedAt

  institution   institutions   @relation(fields: [institution_id], references: [id])
  academic_year academic_years @relation(fields: [academic_year_id], references: [id])
  site          sites?         @relation(fields: [site_id], references: [id])

  @@index([institution_id, academic_year_id])
  @@index([site_id])
  @@map("calendar_events")
}

model timetable_slots {
  id             String   @id @default(uuid())
  institution_id String
  course_id      String
  module_id      String
  site_id        String?
  day_of_week    Int
  starts_at      String
  ends_at        String
  title          String?
  location       String?
  color          String?
  emoji          String?
  image_url      String?
  is_deleted     Boolean  @default(false)
  created_at     DateTime @default(now())
  updated_at     DateTime @default(now()) @updatedAt

  institution        institutions         @relation(fields: [institution_id], references: [id])
  course             courses              @relation(fields: [course_id], references: [id])
  module             modules              @relation(fields: [module_id], references: [id])
  site               sites?               @relation(fields: [site_id], references: [id])
  attendance_records attendance_records[]

  @@index([course_id])
  @@index([module_id])
  @@map("timetable_slots")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
}

model student_enrollments {
  id               String   @id @default(uuid())
  student_id       String
  course_id        String
  academic_year_id String
  institution_id   String
  is_deleted       Boolean  @default(false)
  created_at       DateTime @default(now())
  updated_at       DateTime @default(now()) @updatedAt

  student       students       @relation(fields: [student_id], references: [id])
  course        courses        @relation(fields: [course_id], references: [id])
  academic_year academic_years @relation(fields: [academic_year_id], references: [id])
  institution   institutions   @relation(fields: [institution_id], references: [id])

  @@unique([student_id, course_id, academic_year_id])
  @@index([course_id, academic_year_id])
  @@index([institution_id])
  @@map("student_enrollments")
}

model attendance_records {
  id                String           @id @default(uuid())
  student_id        String
  timetable_slot_id String
  attendance_date   DateTime         @db.Date
  status            AttendanceStatus
  is_deleted        Boolean          @default(false)
  created_at        DateTime         @default(now())
  updated_at        DateTime         @default(now()) @updatedAt

  student        students        @relation(fields: [student_id], references: [id])
  timetable_slot timetable_slots @relation(fields: [timetable_slot_id], references: [id])

  @@unique([student_id, timetable_slot_id, attendance_date])
  @@index([timetable_slot_id, attendance_date])
  @@map("attendance_records")
}

model site_whatsapp {
  id           String   @id @default(uuid())
  site_id      String   @unique
  session_name String   @unique
  is_deleted   Boolean  @default(false)
  created_at   DateTime @default(now())
  updated_at   DateTime @default(now()) @updatedAt

  site sites @relation(fields: [site_id], references: [id])

  @@map("site_whatsapp")
}

model support_tickets {
  id         String              @id @default(uuid())
  site_id    String
  chat_id    String
  code       String              @unique
  status     SupportTicketStatus @default(OPEN)
  preview    String?
  opened_at  DateTime?
  created_at DateTime            @default(now())
  updated_at DateTime            @default(now()) @updatedAt

  site     sites              @relation(fields: [site_id], references: [id])
  messages support_messages[]

  @@index([site_id, chat_id])
  @@map("support_tickets")
}

model support_messages {
  id              String                  @id @default(uuid())
  ticket_id       String
  direction       SupportMessageDirection
  body            String
  waha_message_id String?
  created_at      DateTime                @default(now())

  ticket support_tickets @relation(fields: [ticket_id], references: [id])

  @@index([ticket_id])
  @@map("support_messages")
}
