PORT=5156
# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
# Used for Prisma Migrations and within your application
DATABASE_URL="postgres://postgres:custom_password@aws-0-eu-west-1.pooler.supabase.com:5432/postgres"
SUPABASE_URL="https://supabase.com"
SUPABASE_ANON_KEY="supabase-anon-or-service-role-key"
# Optional dedicated service role for storage uploads (falls back to SUPABASE_ANON_KEY)
# SUPABASE_SERVICE_ROLE_KEY="supabase-service-role-key"
FRONTEND_URL="http://localhost:3000"

# WhatsApp (WAHA) — required for campus Support
WAHA_BASE_URL="http://localhost:8001"
WAHA_API_KEY="your-waha-api-key"
WAHA_WEBHOOK_SECRET="a-long-random-secret"
# URL WAHA uses to call your API. If WAHA runs in Docker on Windows/Mac, use host.docker.internal
# (not localhost — that is the container itself).
PUBLIC_API_URL="http://host.docker.internal:5156"
